{
  "name": "@modernrelay/orbit-engine-cosmos",
  "version": "0.19.0",
  "description": "cosmos.gl engine adapter for Orbit: GPU force layout, native picking, context-loss recovery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ModernRelay/orbit.git",
    "directory": "packages/engine-cosmos"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmos.gl/graph": "3.5.1",
    "@luma.gl/core": "~9.3.6",
    "@luma.gl/engine": "~9.3.6",
    "@luma.gl/shadertools": "~9.3.6",
    "@luma.gl/webgl": "~9.3.6",
    "@modernrelay/orbit-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
